# Copy to .env and fill in your own values. Never commit a real .env.
# Only needed to re-run training (train_final.py). Running the
# Streamlit app or the FastAPI backend does NOT need these.

# Snowflake account for training-data download (train_final.py)
SNOW_USER=
SNOW_PASS=
SNOW_ACCOUNT=

# Optional: override model file locations for the FastAPI backend
# FORMULATION_MODEL_PATH=bicep_model_v2.pkl
# FORMULATION_YOLO_PATH=yolov8n-pose.pt
